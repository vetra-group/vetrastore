# Set the real public domain before deploying; used in canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-local submissions, staff dashboard, and simulated payments/notifications.
# Set true only for local demos. Rebuild after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_DEMO_MODE=false
# Protect staging from indexing even when demo mode is disabled.
SITE_NOINDEX=false

# Application data. With no URI, forms respond with a retryable 503 and keep input.
MONGODB_URI=
MONGODB_DB=vetra_store

# Only enables non-binding order enquiries. No payments are collected.
ORDER_ENQUIRIES_ENABLED=false

# Real payment orders are separate from enquiries and browser-only simulations.
# Enable only after configuring durable MongoDB CMS storage, published products,
# Thai delivery/stock operations, and a verified Stripe webhook endpoint.
PAYMENTS_ENABLED=false
PAYMENT_PRIMARY_PROVIDER=stripe
# Generate a random secret of at least 32 characters; server-side only.
PAYMENT_ACCESS_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local media works by default. See docs/MEDIA_SETUP.md before enabling Cloudinary.
CLOUDINARY_MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep empty for the current local preview. Enable together for live CMS use.
# MongoDB must support transactions (a replica set, including Atlas).
CMS_STORAGE=
CMS_AUTH_MODE=
CMS_SESSION_SECRET=
# JSON array: id, email, name, role (owner/editor), passwordHash, sessionVersion.
# Generate hashes with scripts/hash-staff-password.mjs; never store plain passwords.
CMS_STAFF_ACCOUNTS=
CMS_CLOUDINARY_FOLDER=vetra-cms
